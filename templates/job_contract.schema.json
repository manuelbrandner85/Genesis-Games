{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GENESIS work-order handoff (not runtime world-state)",
  "type": "object",
  "required": ["task_id", "project_id", "base_commit", "owner_role", "status", "acceptance_criteria", "evidence_paths"],
  "properties": {
    "task_id": {"type":"string","pattern":"^WK-[A-Z0-9-]+$"},
    "project_id": {"const":"GENESIS"},
    "base_commit": {"type":"string"},
    "owner_role": {"type":"string"},
    "canon_revision": {"type":"string"},
    "inputs_sha256": {"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "allowed_paths": {"type":"array","items":{"type":"string"}},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "acceptance_criteria": {"type":"array","minItems":1,"items":{"type":"string"}},
    "test_commands": {"type":"array","items":{"type":"string"}},
    "status": {"enum":["PLANNED","WAITING_APPROVAL","RUNNING","BLOCKED","BUILT_UNTESTED","TEST_FAILED","VERIFIED","ACCEPTED"]},
    "evidence_paths": {"type":"array","items":{"type":"string"}},
    "approval_id": {"type":["string","null"]},
    "next_action": {"type":"string"}
  },
  "additionalProperties": true
}
